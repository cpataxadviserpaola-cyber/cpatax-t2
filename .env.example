# Brevo (Sendinblue) Transactional Email Configuration
# Copy this file to .env and replace the values with your actual Brevo credentials.

# Your Brevo API key (v3) - generate from Brevo Dashboard -> SMTP & API -> API Keys
VITE_BREVO_API_KEY=xkeysib-your-api-key-here

# Template IDs created in Brevo Dashboard -> Transactional -> Templates
VITE_BREVO_NOTIFICATION_TEMPLATE_ID=1
VITE_BREVO_AUTOREPLY_TEMPLATE_ID=2

# (Optional) The email where form submissions should be received
# Defaults to contactus@cpataxadviser.com if omitted
VITE_FORM_RECEIVER_EMAIL=contactus@cpataxadviser.com

# (Optional) If you prefer using a custom backend or serverless form endpoint instead:
# VITE_FORM_ENDPOINT=/api/contact
